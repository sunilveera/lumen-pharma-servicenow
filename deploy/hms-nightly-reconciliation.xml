<script><![CDATA[// Nightly reconciliation of ward beds and patient ages
var wardsFixed = new WardUtils().reconcileBeds(false);
var agesFixed  = new PatientUtils().recalculateAllAges(false);

if (wardsFixed > 0) {
    // Beds should never drift if the business rules work, so a fix here means something bypassed them.
    gs.warn('HMS nightly: corrected ' + wardsFixed + ' ward bed count(s). Investigate what bypassed the rules.');
}
gs.info('HMS nightly: wards fixed ' + wardsFixed + ', ages fixed ' + agesFixed);]]></script>
